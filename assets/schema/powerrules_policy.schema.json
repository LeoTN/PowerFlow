{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/LeoTN/PowerRules/main/assets/schema/powerrules_policy.schema.json",
    "title": "PowerRules Policy",
    "description": "Schema for PowerRules policy files.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "rules"
    ],
    "properties": {
        "rules": {
            "type": "array",
            "description": "Ordered list of rules. The first matching rule is executed.",
            "items": {
                "$ref": "#/$defs/rule"
            }
        }
    },
    "$defs": {
        "rule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "conditions",
                "action"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Human-readable name of the rule."
                },
                "enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether the rule is enabled."
                },
                "conditions": {
                    "$ref": "#/$defs/condition"
                },
                "action": {
                    "$ref": "#/$defs/action"
                }
            }
        },
        "condition": {
            "type": "object",
            "oneOf": [
                {
                    "required": [
                        "and"
                    ],
                    "properties": {
                        "and": {
                            "type": "array",
                            "minItems": 2,
                            "items": {
                                "$ref": "#/$defs/condition"
                            }
                        }
                    }
                },
                {
                    "required": [
                        "or"
                    ],
                    "properties": {
                        "or": {
                            "type": "array",
                            "minItems": 2,
                            "items": {
                                "$ref": "#/$defs/condition"
                            }
                        }
                    }
                },
                {
                    "required": [
                        "not"
                    ],
                    "properties": {
                        "not": {
                            "$ref": "#/$defs/condition"
                        }
                    }
                },
                {
                    "required": [
                        "process"
                    ],
                    "properties": {
                        "process": {
                            "$ref": "#/$defs/processCondition"
                        }
                    }
                },
                {
                    "required": [
                        "datetime"
                    ],
                    "properties": {
                        "datetime": {
                            "$ref": "#/$defs/dateTimeCondition"
                        }
                    }
                },
                {
                    "required": [
                        "window"
                    ],
                    "properties": {
                        "window": {
                            "$ref": "#/$defs/windowCondition"
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "processCondition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "running"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the process."
                },
                "running": {
                    "type": "boolean",
                    "description": "Whether the process is expected to be running."
                },
                "match": {
                    "$ref": "#/$defs/match"
                }
            }
        },
        "dateTimeCondition": {
            "type": "object",
            "oneOf": [
                {
                    "required": [
                        "between"
                    ],
                    "properties": {
                        "between": {
                            "$ref": "#/$defs/timeRange"
                        }
                    }
                },
                {
                    "required": [
                        "weekday"
                    ],
                    "properties": {
                        "weekday": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Monday",
                                    "Tuesday",
                                    "Wednesday",
                                    "Thursday",
                                    "Friday",
                                    "Saturday",
                                    "Sunday"
                                ]
                            }
                        }
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "timeRange": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "start",
                "end"
            ],
            "properties": {
                "start": {
                    "$ref": "#/$defs/time"
                },
                "end": {
                    "$ref": "#/$defs/time"
                }
            }
        },
        "time": {
            "type": "string",
            "description": "Time in H, HH, H:MM, HH:MM, H:MM:SS, or HH:MM:SS format.",
            "pattern": "^(?:[0-9]|[01][0-9]|2[0-3])(?::[0-5][0-9](?::[0-5][0-9])?)?$"
        },
        "windowCondition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "exists"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Title of the window."
                },
                "exists": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether the window is expected to exist."
                },
                "match": {
                    "$ref": "#/$defs/match"
                }
            }
        },
        "match": {
            "type": "object",
            "additionalProperties": false,
            "description": "Defines how the value should be matched against the target. By default, an exact, case-sensitive match is used.",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "exact",
                        "regex"
                    ],
                    "default": "exact",
                    "description": "Whether the match should be exact or regex-based."
                },
                "case_sensitive": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether the match should be case-sensitive."
                }
            }
        },
        "action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "shutdown",
                        "sleep",
                        "hibernate",
                        "reboot"
                    ]
                }
            }
        }
    }
}